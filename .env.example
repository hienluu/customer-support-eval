# Copy to .env and fill in. .env is gitignored.

# --- Observability ---------------------------------------------------------
# Logfire *write token* (pylf_v...). Not the management API key.
LOGFIRE_TOKEN=

# --- TARGET: the agent under test ------------------------------------------
# Gemini (default provider)
GOOGLE_API_KEY=
GEMINI_MODEL="gemini-3.1-flash-lite"

# ...or any OpenAI-compatible endpoint. Doubleword:
# TARGET_PROVIDER=openai
# TARGET_MODEL="openai/gpt-oss-20b"
# TARGET_BASE_URL="https://api.doubleword.ai/v1"
# TARGET_API_KEY=
# TARGET_STRICT_TOOLS=false

# --- JUDGE: the LLM-as-a-judge evaluators ----------------------------------
# Prefer a judge that does not share the target's lineage; a same-family judge
# shares its blind spots. Recalibrate after any change here.
JUDGE_MODEL="gemini-3.5-flash-lite"

# JUDGE_PROVIDER=openai
# JUDGE_MODEL="deepseek-ai/deepseek-v4-pro"
# JUDGE_BASE_URL="https://api.doubleword.ai/v1"
# JUDGE_API_KEY=
# JUDGE_STRICT_TOOLS=false          # many open-weight endpoints reject strict tools
# JUDGE_STRUCTURED_OUTPUT=prompted  # if the endpoint's tool-calling is unreliable
# JUDGE_TEMPERATURE=0.0
